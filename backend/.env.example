# Runtime mode: development, staging, or production
APP_ENV=development

# Replace both development-only examples outside local development.
JWT_SECRET=replace-with-a-long-random-jwt-secret
ADMIN_SECRET=replace-with-a-long-random-admin-secret

# Comma-separated exact origins. Wildcards are rejected in staging/production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
